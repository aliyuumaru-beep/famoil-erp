# FamOil Docker stack — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# PostgreSQL
POSTGRES_DB=Famoil
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Odoo master (admin) password — REQUIRED before exposing to any network
# This password protects the /web/database/ manager and config pages.
ODOO_ADMIN_PASSWD=CHANGE_ME_STRONG_PASSWORD

# Host port Odoo listens on (change if 8069 is already in use)
ODOO_PORT=8069
